# Database Configuration
DATABASE_URL=postgresql://topline:topline_secret@127.0.0.1:5432/topline_dev
TEST_DATABASE_URL=postgresql://topline:topline_secret@127.0.0.1:5432/topline_test

# Application
APP_ENV=development
SECRET_KEY=change-this-in-production-use-a-secure-random-key-at-least-32-chars
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=120
REFRESH_TOKEN_EXPIRE_DAYS=7

# Pricing (KSh 1,000 = 100,000 minor units)
PLATFORM_ACCESS_FEE_MINOR=100000
PLATFORM_ACCESS_CURRENCY=KES

# Storage
DOCUMENT_STORAGE_DIR=/home/topsy/Documents/topline/storage/documents
MAX_UPLOAD_SIZE_BYTES=5242880

# M-Pesa Daraja Configuration
MPESA_ENVIRONMENT=sandbox
MPESA_CONSUMER_KEY=placeholder_consumer_key
MPESA_CONSUMER_SECRET=placeholder_consumer_secret
MPESA_SHORTCODE=174379
MPESA_PASSKEY=placeholder_passkey
MPESA_CALLBACK_URL=http://127.0.0.1:8000/api/v1/payments/mpesa/callback

# OTP Configuration
OTP_PROVIDER=mock
OTP_EXPIRY_MINUTES=10

